# ==========================================
# Nord palette: https://www.nordtheme.com
# ==========================================

thm_bg="#2e3440"
thm_fg="#D8DEE9"
thm_br="#3B4252"

# Status bar
set -g status "on"
set -g status-interval 1
set -g status-left-length 40
set -g status-right-length 60
set -g status-bg "${thm_bg}"
set -g status-justify "left"
set -g status-position "bottom"
set -g status-style "fg=#2e3440,bg=default"

# Pane borders
set -g pane-border-style fg="${thm_fg}"
set -g pane-active-border-style "fg=#88C0D0"

# Messages
set -g message-style "fg=#D8DEE9,bg=#434C5E"
set -g message-command-style "fg=#D8DEE9,bg=#434C5E"

# Left: session badge — blue, turns orange when prefix is active
set -g status-left "#{?client_prefix,#[fg=#2E3440 bg=#D08770 bold],#[fg=#2E3440 bg=#81A1C1 bold]} #S #[default] "
# set -g status-left "#{?client_prefix,#[fg=#2E3440 bg=#D08770 bold],#[fg=#2E3440 bg=#81A1C1 bold]} #S #[fg=#81A1C1,bg=#4C566A]#[fg=#E5E9F0,bg=#4C566A] #(echo $USER) #[fg=#4C566A,bg=#3B4252]#[fg=#D8DEE9,bg=#3B4252] #I:#P #[fg=#3B4252,bg=default]"

# Right
set -g status-right "#[fg=#4C566A,bg=default]#[fg=#D8DEE9,bg=#4C566A] %H:%M #[fg=#3B4252,bg=#4C566A]#[fg=#D8DEE9,bg=#3B4252] %d-%b-%y #[fg=#B48EAD,bg=#3B4252]#[fg=#2E3440,bg=#B48EAD,bold] #T "

# Window status — inactive
setw -g window-status-separator ""
setw -g window-status-style "fg=#7B88A1,bg=default"
setw -g window-status-format " #I #W "

# Window status — active
setw -g window-status-current-style "fg=#ECEFF4,bg=default,bold"
setw -g window-status-current-format " #I #W "

# Bell
setw -g window-status-bell-style "fg=#BF616A,bg=default,bold"

# Copy / visual selection
setw -g mode-style "fg=#2E3440,bg=#B48EAD,bold"
