# --- FONT ---
font-family = "JetBrainsMono Nerd Font"
font-size = 17
font-thicken = true
font-thicken-strength = 0
font-feature = liga,calt,clig

# --- THEME ---
theme = Nord
selection-background = #434c5e
selection-foreground = #d8dee9
palette = 8=#4c566a

# --- CURSOR ---
cursor-style = block
cursor-style-blink = false
cursor-color = #b48ead
cursor-text = #2e3440
mouse-hide-while-typing = true
custom-shader = shaders-custom/cursor_tail.glsl
custom-shader = shaders-custom/ripple_cursor.glsl

# --- SHELL/TMUX ---
shell-integration = detect
shell-integration-features = no-cursor,ssh-env,ssh-terminfo,sudo,title
# Auto-attach to an existing tmux session on launch, or create a new one if none exists.
# command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then tmux attach || tmux; else zsh; fi"

# --- WINDOW ---
# title = " "
macos-titlebar-style = transparent
window-save-state = always
confirm-close-surface = true
unfocused-split-opacity = 0.75
split-preserve-zoom = navigation

# --- PADDING ---
window-padding-x = 4
window-padding-y = 4

# -- APPEARANCE ---
background-blur = macos-glass-clear
background-opacity = 0.98

# --- MOUSE ---
copy-on-select = clipboard
scrollback-limit-lines = 100000
clipboard-read = ask
clipboard-write = allow

# --- LINKS ---
link-url = true
clipboard-trim-trailing-spaces = true

# --- NOTIFICATIONS ---
bell-features = system,audio,attention,title

# Directory
tab-inherit-working-directory = true
split-inherit-working-directory = true

# --- KEYBINDINGS ---
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u
keybind = cmd+a>r=reload_config
keybind = cmd+a>x=close_surface
keybind = cmd+a>f=reset_font_size
# Home/End
keybind = super+left=esc:[H
keybind = super+right=esc:[F
keybind = alt+backspace=text:\x17
# Splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface
keybind = super+shift+z=toggle_split_zoom

# Tabs
keybind = alt+left_bracket=previous_tab
keybind = alt+right_bracket=next_tab
keybind = alt+comma=previous_tab
keybind = alt+period=next_tab
keybind = super+shift+n=move_tab_to_new_window
keybind = resize/arrow_up=resize_split:up,10
keybind = resize/arrow_down=resize_split:down,10
keybind = resize/arrow_left=resize_split:left,10
keybind = resize/arrow_right=resize_split:right,10
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=ignore
keybind = cmd+a>s=activate_key_table:resize

# Quick terminal
quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Notify
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# --- MACOS ---
macos-option-as-alt = true
quit-after-last-window-closed = true
macos-dock-drop-behavior = new-window
macos-auto-secure-input = true
macos-secure-input-indication = true
macos-shortcuts = allow
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/icons/nightfly.icns
undo-timeout = 10s

# --- auto-update ---
auto-update = check
auto-update-channel = tip

