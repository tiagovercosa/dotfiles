# --- FONT ---
font-family = Iosevka Nerd Font
font-size = 18
font-thicken = true
font-feature = calt
font-feature = liga

# --- THEME ---
theme = nord
background = #282c35

# --- CURSOR ---
cursor-style = bar
cursor-style-blink = true
cursor-color = #A3BE8C
mouse-hide-while-typing = true

# --- SHELL/TMUX ---
# Auto-attach to an existing tmux session on launch, or create a new one if none exists.
command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then tmux attach || tmux; else zsh; fi"

# --- WINDOW ---
macos-titlebar-style = hidden
window-save-state = always
confirm-close-surface = false
quick-terminal-position = center
shell-integration-features = title

# --- PADDING ---
window-padding-x = 4
window-padding-y = 7

# -- APPEARANCE ---
# window-theme = ghostty
background-blur = true
background-opacity = 0.9
background-blur-radius = 20

# --- MOUSE ---
copy-on-select = clipboard

# --- LINKS ---
link-url = true

# --- NOTIFICATIONS ---
bell-features = system

# --- KEYBINDINGS ---
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u
macos-option-as-alt = left

