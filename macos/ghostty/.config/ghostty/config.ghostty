# --- FONT ---
font-family = Mononoki Nerd Font
font-size = 18
font-thicken = true
font-feature = liga,calt,clig

# --- THEME ---
theme = nord
background = #282c35

# --- CURSOR ---
cursor-style = bar
cursor-style-blink = true
cursor-color = #A3BE8C
mouse-hide-while-typing = true

# --- SHELL/TMUX ---
# Auto-attach to an existing tmux session on launch, or create a new one if none exists.
# command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then tmux attach || tmux; else zsh; fi"

# --- WINDOW ---
macos-titlebar-style = hidden
window-save-state = always
confirm-close-surface = false
quick-terminal-position = center
shell-integration-features = title
window-decoration = auto

# --- PADDING ---
window-padding-x = 10
window-padding-y = 10

# -- APPEARANCE ---
background-blur = true
background-opacity = 0.88
background-blur-radius = 25

# --- MOUSE ---
copy-on-select = clipboard

# --- LINKS ---
link-url = true

# --- NOTIFICATIONS ---
bell-features = system

# -- UPDATES ---
auto-update = check
auto-update-channel = stable

# --- KEYBINDINGS ---
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u
macos-option-as-alt = left

