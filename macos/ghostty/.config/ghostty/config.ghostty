# --- FONT ---
font-family = IosevkaTerm Nerd Font
font-size = 18
font-thicken = true
font-feature = liga,calt,clig

# --- THEME ---
theme = nord
background = #252A33
selection-background = #8FBCBB
selection-foreground = #252A33

# --- CURSOR ---
cursor-style = block
cursor-style-blink = true
cursor-color = #A3BE8C
mouse-hide-while-typing = true

# --- SHELL/TMUX ---
shell-integration = detect
shell-integration-features = no-cursor, ssh-env, ssh-terminfo, sudo, no-title
# Auto-attach to an existing tmux session on launch, or create a new one if none exists.
# command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then tmux attach || tmux; else zsh; fi"

# --- WINDOW ---
title = " "
macos-titlebar-style = tabs
window-save-state = always
confirm-close-surface = false
quick-terminal-position = center

# --- PADDING ---
window-padding-x = 5
window-padding-y = 5

# -- APPEARANCE ---
background-blur = true
background-opacity = 0.88
background-blur-radius = 25

# --- MOUSE ---
copy-on-select = clipboard

# --- LINKS ---
link-url = true
clipboard-trim-trailing-spaces = true

# --- NOTIFICATIONS ---
bell-features = system

# -- UPDATES ---
auto-update = check
auto-update-channel = stable

# --- KEYBINDINGS ---
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u
keybind = cmd+a>r=reload_config
keybind = cmd+a>x=close_surface
keybind = cmd+a>f=reset_font_size

# --- MACOS ---
macos-option-as-alt = left

